# Optional: configure an OpenAI-compatible endpoint in your own environment.
# Keep this file free of real credentials. The application also supports its
# encrypted settings panel. Legacy BATRECYCLER_* names remain API-compatible.
BATRECYCLER_LLM_API_KEY=
BATRECYCLER_LLM_BASE_URL=https://api.example.invalid/v1
BATRECYCLER_LLM_MODEL=your-provider-model
BATRECYCLER_RELOAD=0
BATRECYCLER_HOST=127.0.0.1
BATRECYCLER_PORT=8765

# Standalone search subprocesses use these variables or OPENAI_API_KEY.
BATRECYCLER_EOH_API_KEY=
BATRECYCLER_EOH_BASE_URL=https://api.example.invalid/v1
